<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar：去掉方形全安卓手表上的「应用名」标题栏（真 Wear OS 不受影响） -->
    <style name="Theme.WearGitHubStore" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <!-- 窗口底色与 Compose 默认主题背景保持一致（#1B1B1F），
             避免启动时窗口先绘制纯黑、内容再绘制深灰导致的「闪一下黑屏」。 -->
        <item name="android:windowBackground">#FF1B1B1F</item>
        <item name="android:colorBackground">#FF1B1B1F</item>
    </style>
</resources>
